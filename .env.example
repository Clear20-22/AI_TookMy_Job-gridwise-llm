# ==========================================
# GridWise LLM — Environment Template
# Copy this file to .env and fill in your values.
# DO NOT commit .env — it is listed in .gitignore.
# ==========================================

# Required: Google Gemini API Key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Groq API Key (used by api_benchmark/ only, not the service)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: Override the primary Gemini model.
# Supported values: gemini-3.5-flash-lite | gemini-flash-lite-latest | gemini-3.6-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Server settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO